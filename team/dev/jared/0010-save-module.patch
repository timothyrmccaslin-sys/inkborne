+    #[test] fn live_items_json_equipment() {
+        // The live data/items.json carries Ollie's `equipment` (slot, per-item equippable_by, starting_for).
+        let raw = std::fs::read_to_string("../data/items.json").unwrap();
+        let v: Value = serde_json::from_str(&raw).unwrap();
+        let Some(eqs) = v["equipment"].as_array() else { return }; // nothing to check on an items-only file
+        let mut a = g(); assert!(a.set_equipment(&raw));
+        let slots: Vec<String> = { let mut s: Vec<String> = vec![]; for e in eqs { let x = e["slot"].as_str().unwrap().to_string(); if !s.contains(&x) { s.push(x); } } s };
+        assert_eq!(a.st.meta.equip.slots, slots);
+        // starting gear is equipped on a fresh game
+        for e in eqs { if let Some(m) = e["starting_for"].as_str() {
+            assert_eq!(a.st.equipped[m][e["slot"].as_str().unwrap()].as_deref(), e["id"].as_str(), "starting gear for {m}");
+        } }
+        // an item limited to one member cannot be worn by another; it is dropped with not_equippable
+        if let Some(e) = eqs.iter().find(|e| e["equippable_by"].as_array().map(|x| x.len() == 1).unwrap_or(false)) {
+            let owner = e["equippable_by"][0].as_str().unwrap();
+            let other = a.party.iter().map(|m| m.id.clone()).find(|m| m != owner).unwrap();
+            let slot = e["slot"].as_str().unwrap(); let id = e["id"].as_str().unwrap();
+            assert!(!a.equip(&other, slot, id));
+            let s = format!(r#"{{"version":1,"equipped":{{"{other}":{{"{slot}":"{id}"}},"{owner}":{{"{slot}":"{id}"}}}}}}"#);
+            assert!(a.load_json(&s));
+            assert!(has(&a, "not_equippable", &format!("equipped.{other}.{slot}")));
+            assert_eq!(a.st.equipped[owner][slot].as_deref(), Some(id));
+            let out = a.save_json(); let mut b = g(); assert!(b.set_equipment(&raw)); assert!(b.load_json(&out)); assert_eq!(b.save_json(), out);
+            assert_eq!(warns(&b), Vec::<Value>::new());
+        }
+    }
+
+    #[test] fn equip_validates() {
+        let mut a = g();
+        assert!(!a.equip("itsuki", "weapon", "t_robe"));
+        assert!(!a.equip("itsuki", "hat", "t_brush"));
+        assert!(!a.equip("nobody", "weapon", "t_brush"));
+        assert!(!a.equip("itsuki", "weapon", "missing"));
+        assert!(a.equip("itsuki", "weapon", "t_brush"));
+        assert!(a.equip("itsuki", "weapon", ""));
+        let v: Value = serde_json::from_str(&a.equipped_json()).unwrap();
+        assert!(v["itsuki"]["weapon"].is_null());
+        // Jane's real file today: 3 slots, every id null -> no valid equipment ids.
+        let jane = r#"{"slots":["weapon","armor","accessory"],"equippable_by":["itsuki","benika","gonzo"],"equipment":[{"id":null,"slot":"weapon"}]}"#;
+        assert!(a.set_equipment(jane));
+        assert!(a.st.meta.equip.ids.is_empty()); assert_eq!(a.st.meta.equip.slots.len(), 3);
+        assert!(!a.set_equipment("not json"));
+    }
